# Telethon (user account) — получить на https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+79001234567

# Новый бот для отправки в группу — создать через @BotFather
NEWS_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ID закрытой группы (начинается с -100...)
TARGET_GROUP_ID=-1001234567890

# Каналы-источники (через запятую, без @)
SOURCE_CHANNELS=channel1,channel2,channel3

# (Опционально) Ключевые слова для фильтрации — пусто = все посты
KEYWORDS=
